LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=claude-sonnet-4-5-20250929
# Optional per-role model overrides
# SUBAGENT_MODEL=claude-sonnet-4-5-20250929
# TEAMMATE_MODEL=claude-sonnet-4-5-20250929
# COMPACT_MODEL=claude-haiku-4-5-20251001
# Optional provider thinking defaults for new conversations
THINKING_ENABLED=false
THINKING_EFFORT=high
# DeepSeek V4 example:
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL=deepseek-v4-pro
# SUBAGENT_MODEL=deepseek-v4-flash
# TEAMMATE_MODEL=deepseek-v4-flash
# COMPACT_MODEL=deepseek-v4-flash
# THINKING_ENABLED=true
# THINKING_EFFORT=max
MAX_TURNS=50
MAX_TOKEN_BUDGET=200000
SKILLS_DIR=skills
WORKSPACE_DIR=workspace
BASH_TIMEOUT=60
# ALLOWED_COMMANDS=ls,cat,grep,find,python3,git,npm
DATABASE_URL=sqlite+aiosqlite:///./agent.db
# Google Auth (optional — leave empty to disable authentication)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
