# Required: choose a provider and set its API key
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: Custom Anthropic base URL (e.g., for DeepSeek compatibility)
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Optional: Custom OpenAI-compatible base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Model override (default: claude-sonnet-4-5-20250929)
# MODEL=claude-opus-4-6

# Optional: Workspace cleanup delay in seconds (default: 300)
# WORKSPACE_CLEANUP_DELAY=300

# Optional: Disable session memory (default: true)
# ENABLE_MEMORY=false

# Optional: Database URL (default: sqlite+aiosqlite:///./agent.db)
# DATABASE_URL=sqlite+aiosqlite:///./agent.db

# Optional: Bash command timeout in seconds (default: 60)
# BASH_TIMEOUT=60

# Optional: Background task timeout in seconds (default: 300)
# BACKGROUND_TIMEOUT=300

# Optional: Max agent turns per request (default: 50)
# MAX_TURNS=50

# Optional: Max output tokens per LLM call (default: 16384)
# MAX_OUTPUT_TOKENS=16384

# Optional: Context window size (default: 200000)
# CONTEXT_WINDOW=200000

# Optional: Compact threshold as fraction of context window (default: 0.7)
# COMPACT_THRESHOLD=0.7

# Optional: LLM retry settings
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE_DELAY=1.0
# LLM_RETRY_MAX_DELAY=30.0

# Optional: MCP servers config file path (default: mcp_servers.json)
# MCP_SERVERS_FILE=mcp_servers.json

# Optional: Temperature settings (0.0-1.0)
# TEMPERATURE=1.0
# SUBAGENT_TEMPERATURE=0.5
# TEAMMATE_TEMPERATURE=0.7
# COMPACT_TEMPERATURE=0.2

# Optional: CLI agent loop timeout in seconds (default: 1800)
# OPENAGENT_TIMEOUT=1800
